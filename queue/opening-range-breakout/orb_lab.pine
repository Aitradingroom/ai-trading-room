//@version=6
indicator("ORB Lab", overlay=true)

costPct = input.float(0.008, "Round-trip cost / spread (% of price)", step=0.001)

// One simulator per variant: session x range length x stop x exit
type Orb
    string tz
    int openMin
    int orMins
    int stopMode   // 0 = opposite side of range, 1 = middle of range
    float rr       // 0 = exit at session end, otherwise fixed R target
    float orH = na
    float orL = na
    bool building = false
    bool ready = false
    bool traded = false
    int phase = 0  // 0 idle, 1 pending entry, 2 in trade
    int dir = 0
    float entry = na
    float stop = na
    float target = na
    float risk = na
    int n = 0
    int wins = 0
    float sumR = 0.0

method closeTrade(Orb s, float px) =>
    if s.risk > 0
        float r = s.dir == 1 ? (px - s.entry) / s.risk : (s.entry - px) / s.risk
        float net = r - costPct / 100 * s.entry / s.risk
        s.n := s.n + 1
        if net > 0
            s.wins := s.wins + 1
        s.sumR := s.sumR + net
    s.phase := 0

method update(Orb s) =>
    int mod = hour(time, s.tz) * 60 + minute(time, s.tz)
    bool inOR    = mod >= s.openMin and mod < s.openMin + s.orMins
    bool inTrade = mod >= s.openMin + s.orMins and mod < s.openMin + 360
    bool entryOk = mod >= s.openMin + s.orMins and mod < s.openMin + 240
    bool fillBar = false
    // session window over: flat at this bar's open
    if s.phase == 2 and not inTrade
        s.closeTrade(open)
    // pending market entry fills at this bar's open
    if s.phase == 1
        if inTrade
            s.entry := open
            bool valid = s.dir == 1 ? s.stop < s.entry : s.stop > s.entry
            if valid
                s.risk := math.abs(s.entry - s.stop)
                s.target := s.rr > 0 ? s.entry + s.dir * s.rr * s.risk : na
                s.phase := 2
                fillBar := true
            else
                s.phase := 0
        else
            s.phase := 0
    // build the opening range
    if inOR
        if not s.building
            s.orH := high
            s.orL := low
            s.building := true
            s.ready := false
            s.traded := false
        else
            s.orH := math.max(s.orH, high)
            s.orL := math.min(s.orL, low)
    else if s.building
        s.building := false
        s.ready := true
    if not entryOk
        s.ready := false
    // manage open trade
    if s.phase == 2
        bool hitStop = s.dir == 1 ? low <= s.stop : high >= s.stop
        bool hitTgt = not na(s.target) and (s.dir == 1 ? high >= s.target : low <= s.target)
        if hitStop
            s.closeTrade(s.dir == 1 ? math.min(s.stop, open) : math.max(s.stop, open))
        else if hitTgt and not fillBar
            s.closeTrade(s.target)
    // breakout signal on bar close, one trade per session per day
    if s.ready and not s.traded and s.phase == 0 and inTrade
        float mid = (s.orH + s.orL) / 2
        if close > s.orH
            s.dir := 1
            s.stop := s.stopMode == 0 ? s.orL : mid
            s.phase := 1
            s.traded := true
        else if close < s.orL
            s.dir := -1
            s.stop := s.stopMode == 0 ? s.orH : mid
            s.phase := 1
            s.traded := true

// sessions: Sydney 07:00, Tokyo 09:00, London 08:00, New York 09:30 (local time, DST-aware)
// per session: 0 OR15 opp EOD | 1 OR30 opp EOD | 2 OR60 opp EOD | 3 OR30 opp 2R | 4 OR30 mid EOD
var array<Orb> sims = array.new<Orb>()
if barstate.isfirst
    array<string> tzs = array.from("Australia/Sydney", "Asia/Tokyo", "Europe/London", "America/New_York")
    array<int> opens = array.from(420, 540, 480, 570)
    for si = 0 to 3
        string z = tzs.get(si)
        int o = opens.get(si)
        sims.push(Orb.new(z, o, 15, 0, 0.0))
        sims.push(Orb.new(z, o, 30, 0, 0.0))
        sims.push(Orb.new(z, o, 60, 0, 0.0))
        sims.push(Orb.new(z, o, 30, 0, 2.0))
        sims.push(Orb.new(z, o, 30, 1, 0.0))
for s in sims
    s.update()

var int firstDate = year * 10000 + month * 100 + dayofmonth
plot(firstDate, "Start", display=display.status_line)
